// Check the wiki for a full description of the configuration:
// https://yalter.github.io/niri/Configuration:-Introduction

// Find the full list of options on the wiki:
// https://yalter.github.io/niri/Configuration:-Input

// Private window rules, not in the repo (.gitignore): niri starts without them,
// and scripts/private-rules-check.sh then says so. block-screen-capture.kdl.example
// is what to start one from.
include optional=true "block-screen-capture.kdl"
include "animations/prism-glide.kdl"

blur {
    passes 2
    offset 3
    noise 0.02
    saturation 1.5
}

input {
    keyboard {
        xkb {
            layout "pl"
        }

        numlock
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.4
    }

    mouse {
        accel-speed 0.2
        scroll-factor 1.6
    }
}

// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Outputs
output "eDP-1" {
    mode "2880x1920@120.000"
    variable-refresh-rate   // re-enabled 2026-09-05: disproved as hang cause (3rd hang happened with VRR off)

    scale 1.6

    transform "normal"

    position x=0 y=0
}

// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Layout
layout {
    gaps 12

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2

        active-gradient from="#74c7ec" to="#a6e3a1" angle=45 relative-to="window"

        inactive-color "#181825b3"
    }

    border {
        on

        width 0
        active-color "#181825b3"
        inactive-color "#7f849cb3"
    }

    shadow {
        on

        softness 20

        spread 2

        offset x=0 y=0

        color "#1792998c"
    }

    // Set transparent workspace background color.
    background-color "transparent"
}

recent-windows {
    // Round the corners on the highlight.
    open-delay-ms 0
    highlight {
        corner-radius 6
        active-color "#74c7ec"
        urgent-color "#f38ba8"
        padding 30
    }
    previews {
        max-height 700
        max-scale 1.0
    }
}

spawn-at-startup "~/.config/niri/scripts/flatpak-gtk-theme.sh"
// Says so if the private window rules included at the top are not there.
spawn-at-startup "~/.config/niri/scripts/private-rules-check.sh"

cursor {
    // Change the theme and size of the cursor as well as set the
    // `XCURSOR_THEME` and `XCURSOR_SIZE` env variables.
    xcursor-theme "Simp1e-Catppuccin-Mocha"
    xcursor-size 24
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Settings for the "Important Hotkeys" overlay.
hotkey-overlay {
    skip-at-startup
}

window-rule {
    default-column-width { proportion 0.5; }
    geometry-corner-radius 6
    clip-to-geometry true
    draw-border-with-background false
    opacity 1.0
}

// Open the Firefox Picture-in-Picture window at the bottom-left corner of the screen
// with a small gap.

// Turn on shadows for floating windows.
window-rule {
    match is-floating=true
    opacity 0.95
    shadow {
        on
        color "#1792998c"
    }
    background-effect {
        blur true
        xray false
    }
    default-floating-position x=0 y=600 relative-to="top"
}

// Make inactive windows more transparent.
window-rule {
    match is-active=false
    opacity 0.95
    shadow {
       on
       color "#000000"
    }
    background-effect {
        blur true
        xray true
    }
}
window-rule {
    match app-id="ghostty" is-active=true
    match app-id="org.gnome.Nautilus" is-active=true
    match app-id="de.haeckerfelix.Fragments" is-active=true
    match app-id="org.gnome.Logs" is-active=true
    match app-id="org.gnome.baobab" is-active=true
    match app-id="org.gnome.font-viewer" is-active=true
    opacity 0.95
    background-effect {
        blur true
        xray true
    }
}
window-rule {
    match app-id="ghostty" is-active=false
    match app-id="org.gnome.Nautilus" is-active=false
    match app-id="de.haeckerfelix.Fragments" is-active=false
    match app-id="org.gnome.Logs" is-active=false
    match app-id="org.gnome.baobab" is-active=false
    match app-id="org.gnome.font-viewer" is-active=false
    opacity 0.90
}

// Open maximized
window-rule {
    match app-id="firefox"
    match app-id="firefox-nightly"
    match app-id="thunderbird"
    match title="ONLYOFFICE"
    match app-id="spotify"
    match app-id="discord"
    match app-id="WinBox"
    match app-id="resolve"
    match app-id="^steam$" // not steam_app_…, the games' windows
    match app-id="google-chrome"
    match app-id="obsidian"
    match app-id="Godot"
    match app-id="REAPER"
    match app-id="RapidRAW"
    match app-id="^electron$"
    match app-id="art.graphite.Graphite"
    open-maximized true
}
// Width 0.8
window-rule {
    match title=r"^Signal( \(\d+\))?$" // with or without the count of unread
    default-column-width { proportion 0.8; }
}
// Width 0.6
window-rule {
    match app-id="Tuba"
    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id="firefox" is-active=true
    match app-id="firefox-nightly" is-active=true
    draw-border-with-background true
}
//Picture-in-Picture
window-rule {
    match app-id="zen$" title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-left"
}
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    match app-id="firefox-nightly$" title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-left"
}
// Godot
window-rule {
    match app-id="Godot" title="Create New Node"
    open-floating true
    default-window-height { fixed 750; }
}

/-window-rule {
    match app-id="WinBox"
    match app-id="resolve"
    open-fullscreen false
}
// MPV
window-rule {
    match app-id="mpv" is-floating=true
    opacity 0.99
}
// Reaper
window-rule {
    match app-id="REAPER"
    default-floating-position x=80 y=300 relative-to="top"
}
window-rule {
    match app-id="REAPER" title="Open project"
    match app-id="REAPER" title="REAPER Preferences"
    match app-id="REAPER" title="Save Project"
    default-column-width { proportion 0.6; }
}

// Floating windows
window-rule {
    match app-id="resolve" title="resolve"
    match app-id="resolve" title="Create New Project"
    match app-id="firefox" title="About Mozilla Firefox"
    match app-id="firefox" title="Library"
    match app-id="firefox-nightly" title="About Firefox Nightly"
    match app-id="firefox-nightly" title="Library"
    match app-id="thunderbird" title="About Mozilla Thunderbird"
    match app-id="com.network.manager"
    open-floating true
}

layer-rule {
    match namespace="^launcher$"
    shadow {
        on
        color "#1792998c" // "#0007"
    }
    opacity 0.85
    // Fuzzel defaults to 10 px rounded corners.
    geometry-corner-radius 10
    baba-is-float false
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="logout_dialog"
    opacity 0.9
    background-effect {
        blur true
        xray false
    }
}

// Quickshell bar (~/.config/quickshell). The surface is taller than the
// bar so popups can grow out of it; the shape, shadow and blur region are drawn by
// the bar itself, so no shadow or corner radius here.
layer-rule {
    match namespace="^quickshell-bar$"
    opacity 0.9
    // Blur what is really under the popups, not just the wallpaper.
    background-effect {
        xray false
    }
}

// Quickshell volume/brightness OSD: like the bar, it draws its own shape,
// shadow and blur region.
layer-rule {
    match namespace="^quickshell-osd$"
    opacity 0.9
    background-effect {
        xray false
    }
}

// Quickshell centered power menu, like the OSD.
layer-rule {
    match namespace="^quickshell-power$"
    opacity 0.9
    background-effect {
        xray false
    }
}

// Quickshell launcher, like the OSD.
layer-rule {
    match namespace="^quickshell-launcher$"
    opacity 0.85
    background-effect {
        xray false
    }
}

// Quickshell notifications, like the OSD.
layer-rule {
    match namespace="^quickshell-notifications$"
    opacity 0.9
    background-effect {
        xray false
    }
}

// Indicate screencasted windows with red colors.
window-rule {
    match is-window-cast-target=true

    focus-ring {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }

    border {
        inactive-color "#7d0d2d"
    }

    shadow {
        color "#7d0d2dbb"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

// Make the wallpaper stationary, rather than moving with workspaces.
/-layer-rule {
    // This is for swaybg; change for other wallpaper tools.
    // Find the right namespace by running niri msg layers.
    match namespace="awww-daemon"
    place-within-backdrop true
}
overview {
    backdrop-color "#11111b" //"#1e1e2e"
    zoom 0.6
    workspace-shadow {
        on
    }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Open terminal" { spawn-sh "ghostty +new-window || ghostty"; }
    Mod+Space hotkey-overlay-title="Open launcher" { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    // For when quickshell is down.
    Mod+Shift+Space hotkey-overlay-title="Open fuzzel" { spawn "fuzzel"; }
    Mod+B hotkey-overlay-title="Open Firefox" { spawn "firefox"; }
    Mod+N hotkey-overlay-title="Open Firefox in Private Mode" { spawn-sh "firefox --private-window"; }
    Mod+P hotkey-overlay-title="Open Nautilus" { spawn-sh "nautilus -w"; }
    Mod+L hotkey-overlay-title="Lock screen" allow-when-locked=false { spawn-sh "loginctl lock-session"; }
    Mod+Escape hotkey-overlay-title="Power menu" allow-when-locked=false { spawn "qs" "ipc" "call" "power" "toggle"; }
    Mod+Shift+N hotkey-overlay-title="Notification center" allow-when-locked=false { spawn "qs" "ipc" "call" "notifications" "toggle"; }
    Mod+Ctrl+N hotkey-overlay-title="Do not disturb" allow-when-locked=false { spawn "qs" "ipc" "call" "notifications" "toggleDnd"; }
    Mod+Alt+N hotkey-overlay-title="Send toasts to the notification center" allow-when-locked=false { spawn "qs" "ipc" "call" "notifications" "dismissToasts"; }
    Mod+S hotkey-overlay-title="Shuffle wallpaper" { spawn "~/.config/niri/scripts/wallpaper.sh"; }
    Mod+X hotkey-overlay-title="Shuffle wallpaper, second set" { spawn-sh "~/.config/niri/scripts/wallpaper.sh ~/Pictures/.Wallpapers2 random"; }
    Mod+M hotkey-overlay-title="Open MPV" { spawn-sh "mpv --player-operation-mode=pseudo-gui"; }

    XF86AudioRaiseVolume 	allow-when-locked=true { spawn "~/.config/niri/scripts/volume.sh" "up"; }
    XF86AudioLowerVolume 	allow-when-locked=true { spawn "~/.config/niri/scripts/volume.sh" "down"; }
    XF86AudioMute			allow-when-locked=true { spawn "~/.config/niri/scripts/volume.sh" "mute"; }
    XF86AudioMicMute 		allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioNext 			allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev 			allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioPlay 			allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop 			allow-when-locked=true { spawn-sh "playerctl stop"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+V       { toggle-window-floating; }
    Mod+0 		{ toggle-window-rule-opacity; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Ctrl+Shift+F { toggle-windowed-fullscreen; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }
}
